# העתיקו קובץ זה ל-.env ושנו לפי הצורך. אין צורך במפתח API עבור Open-Meteo.
AIRMATRIX_WEATHER_URL=https://api.open-meteo.com/v1/forecast
AIRMATRIX_HTTP_TIMEOUT=5
AIRMATRIX_MAX_ATTEMPTS=3
AIRMATRIX_RETRY_DELAY=1
# false = הרצה ללא רשת עם נתונים מדומים; true = פנייה לשירות האמיתי
AIRMATRIX_USE_LIVE_API=false
